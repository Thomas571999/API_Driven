# Variables
AWS := aws --endpoint-url=$$AWS_ENDPOINT_URL
API_URL := http://localhost:4566/restapis/$$API_ID/dev/_user_request_/ec2

# -------------------------
# DEPLOY LAMBDA
# -------------------------
deploy-lambda:
	cd lambda && zip lambda.zip lambda_function.py && cd ..
	$(AWS) lambda update-function-code \
		--function-name ec2-controller \
		--zip-file fileb://lambda/lambda.zip

# -------------------------
# EC2 ACTIONS
# -------------------------
stop:
	curl -s -X POST $(API_URL) \
	-H "Content-Type: application/json" \
	-d '{"action":"stop"}'

start:
	curl -s -X POST $(API_URL) \
	-H "Content-Type: application/json" \
	-d '{"action":"start"}'

status:
	curl -s -X POST $(API_URL) \
	-H "Content-Type: application/json" \
	-d '{"action":"status"}'

# -------------------------
# FULL TEST FLOW
# -------------------------
test-all:
	make stop
	make start
	make status

logs:
	aws --endpoint-url=$$AWS_ENDPOINT_URL logs describe-log-groups

setup:
	aws --endpoint-url=$$AWS_ENDPOINT_URL ec2 describe-instances

deploy-infra:
	aws --endpoint-url=$$AWS_ENDPOINT_URL lambda create-function ...
	aws --endpoint-url=$$AWS_ENDPOINT_URL apigateway create-rest-api ...

deploy-all: deploy-lambda deploy-api

test:
	make stop && make start && make status

clean:
	aws --endpoint-url=$$AWS_ENDPOINT_URL ec2 terminate-instances \
		--instance-ids $$INSTANCE_ID || true
	aws --endpoint-url=$$AWS_ENDPOINT_URL lambda delete-function \
		--function-name ec2-controller || true

full:
	make deploy-lambda
	make test-all

validate:
	./init.sh
	make test-all
	aws --endpoint-url=$$AWS_ENDPOINT_URL ec2 describe-instances
